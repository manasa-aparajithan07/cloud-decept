# CloudDecept Environment Configuration
# Copy this to .env and modify values

# ============================================================
# DEPLOYMENT MODE
# ============================================================
# Set to 'local' for development, 'oracle' for Oracle Cloud Free Tier
DEPLOYMENT_MODE=local

# ============================================================
# DOMAIN & NETWORK
# ============================================================
# Your DuckDNS subdomain (e.g., myhoneypot.duckdns.org)
DUCKDNS_SUBDOMAIN=your-subdomain
DUCKDNS_TOKEN=your-token-from-duckdns

# Public IP or domain for services to reference
PUBLIC_DOMAIN=localhost
PUBLIC_IP=

# ============================================================
# DATABASE PASSWORDS (CHANGE IN PRODUCTION!)
# ============================================================
# ClickHouse
CLICKHOUSE_DB=deception
CLICKHOUSE_USER=deception
CLICKHOUSE_PASSWORD=changeme_production_password

# PostgreSQL
POSTGRES_DB=deception
POSTGRES_USER=deception
POSTGRES_PASSWORD=changeme_production_password

# Redis (optional password)
REDIS_PASSWORD=

# ============================================================
# OLLAMA / LLM SETTINGS
# ============================================================
# Model to use: llama3.2:3b (ARM64 optimized, 2GB model)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Intent Engine
INTENT_MODEL=llama3.2:3b
INTENT_CONFIDENCE_THRESHOLD=0.7
INTENT_MAX_HISTORY=10

# Summarizer
SUMMARIZER_MODEL=llama3.2:3b
SUMMARIZER_MAX_TOKENS=512

# ============================================================
# GEMINI FORENSIC INTERPRETATION (SERVER-SIDE ONLY)
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest


# ============================================================
# HONEYPOT SETTINGS
# ============================================================
# Cowrie SSH
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223

# HoneyPot User Database (modify for production)
COWRIE_USERDB=configs/cowrie/cowrie/userdb.txt

# Organization Profiles (AWS, Azure, GCP)
ORG_PROFILES=techcorp-aws,northbridge-healthcare,financeflow-azure,startup-gcp

# ============================================================
# API MOCK SETTINGS
# ============================================================
# Cloud API Mock
CLOUD_API_PORT=8080
CLOUD_API_WORKERS=2

# Metadata service simulation (169.254.169.254)
METADATA_ENABLED=true

# ============================================================
# DASHBOARD SETTINGS
# ============================================================
DASHBOARD_PORT=3000
DASHBOARD_SECRET=changeme_super_secret_key_32_chars_min

# ============================================================
# THREAT INTEL SETTINGS
# ============================================================
# MITRE ATT&CK
MITRE_DATA_PATH=configs/mitre/enterprise-attack.json

# IOC Extraction
IOC_CONFIDENCE_THRESHOLD=0.8

# ============================================================
# ORACLE CLOUD FREE TIER (2 OCPU / 12 GB) RESOURCE LIMITS
# ============================================================
# Used by docker-compose.oracle.yml
# Total target: ~9 GB RAM, leaving ~3 GB for OS

CLICKHOUSE_MEM_LIMIT=2G
CLICKHOUSE_MEM_RESERVE=1G
POSTGRES_MEM_LIMIT=512M
POSTGRES_MEM_RESERVE=256M
REDIS_MEM_LIMIT=256M
REDIS_MEM_RESERVE=128M
OLLAMA_MEM_LIMIT=4G
OLLAMA_MEM_RESERVE=3G
COWRIE_MEM_LIMIT=256M
COWRIE_MEM_RESERVE=128M
CLOUD_API_MEM_LIMIT=384M
CLOUD_API_MEM_RESERVE=256M
INTENT_ENGINE_MEM_LIMIT=384M
INTENT_ENGINE_MEM_RESERVE=256M
ADAPTIVE_ENGINE_MEM_LIMIT=256M
ADAPTIVE_ENGINE_MEM_RESERVE=128M
THREAT_INTEL_MEM_LIMIT=384M
THREAT_INTEL_MEM_RESERVE=256M
DASHBOARD_MEM_LIMIT=256M
DASHBOARD_MEM_RESERVE=128M

# CPU limits (2 OCPU = 2 vCPU total)
CLICKHOUSE_CPUS=0.5
POSTGRES_CPUS=0.25
REDIS_CPUS=0.1
OLLAMA_CPUS=1.0
COWRIE_CPUS=0.1
CLOUD_API_CPUS=0.25
INTENT_ENGINE_CPUS=0.25
ADAPTIVE_ENGINE_CPUS=0.25
THREAT_INTEL_CPUS=0.25
DASHBOARD_CPUS=0.25

# ============================================================
# LOGGING & MONITORING
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE=100m
LOG_MAX_FILES=10

# ============================================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================================
# Slack webhook for alerts
SLACK_WEBHOOK_URL=

# Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# SIEM Export
SIEM_ENDPOINT=
SIEM_API_KEY=

# ============================================================
# STREAM PROCESSOR SETTINGS
# ============================================================
AI_PROCESSOR_ENABLED=true
AI_PROCESSOR_CONSUMER_GROUP=ai_processor
AI_PROCESSOR_CONSUMER_NAME=stream-processor
AI_PROCESSOR_FROM=\$
AI_PROCESSOR_BATCH_SIZE=10
AI_PROCESSOR_TIMEOUT_SECONDS=10
AI_PROCESSOR_RETRY_COUNT=2

# ============================================================
# LOCAL DEVELOPMENT OVERRIDES
# ============================================================
# Uncomment and adjust for local dev
# OLLAMA_HOST=http://host.docker.internal:11434
# POSTGRES_HOST=localhost
# CLICKHOUSE_HOST=localhost
# REDIS_HOST=localhost

# ============================================================
# PRODUCTION (4 OCPU / 24 GB) RESOURCE LIMITS
# ============================================================
# Used by docker-compose.prod.yml (when upgraded)
# CLICKHOUSE_MEM_LIMIT=8G
# CLICKHOUSE_MEM_RESERVE=4G
# POSTGRES_MEM_LIMIT=2G
# POSTGRES_MEM_RESERVE=1G
# REDIS_MEM_LIMIT=1G
# REDIS_MEM_RESERVE=512M
# OLLAMA_MEM_LIMIT=16G
# OLLAMA_MEM_RESERVE=8G
# COWRIE_MEM_LIMIT=1G
# COWRIE_MEM_RESERVE=512M
# CLOUD_API_MEM_LIMIT=1G
# CLOUD_API_MEM_RESERVE=512M
# INTENT_ENGINE_MEM_LIMIT=2G
# INTENT_ENGINE_MEM_RESERVE=1G
# ADAPTIVE_ENGINE_MEM_LIMIT=1G
# ADAPTIVE_ENGINE_MEM_RESERVE=512M
# THREAT_INTEL_MEM_LIMIT=2G
# THREAT_INTEL_MEM_RESERVE=1G
# DASHBOARD_MEM_LIMIT=1G
# DASHBOARD_MEM_RESERVE=512M